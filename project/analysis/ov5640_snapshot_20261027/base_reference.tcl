  connect_bd_net -net hdmi_out_hdmi_out_hpd [get_bd_pins hdmi_out/hdmi_out_hpd] [get_bd_pins hdmi_out_hpd]
  connect_bd_net -net hdmi_out_hdmi_out_hpd_irq [get_bd_pins hdmi_out/hdmi_out_hpd_irq] [get_bd_pins xlconcat_0/In2]
